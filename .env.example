# ==============================
# BizNest Pakistan — Environment Variables
# ==============================

# --- Frontend (safe to expose in browser, VITE_ prefix required) ---
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Maps JavaScript API key (frontend map widget)
VITE_GOOGLE_MAPS_PLATFORM_KEY=your_google_maps_key

# --- Server-side ONLY (NEVER expose to the browser, NO VITE_ prefix) ---
# Used only by Vercel Serverless Functions in /api/gemini/*
GEMINI_API_KEY=your_gemini_key_SERVER_SIDE_ONLY
